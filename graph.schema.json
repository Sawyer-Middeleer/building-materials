{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building materials graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "nodes",
    "statements"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "statements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "scale": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "referenceDesign",
            "productModel",
            "productVariant",
            "material",
            "structureModel",
            "chemicalEntity",
            "process",
            "requirement",
            "actor",
            "source"
          ]
        },
        "stage": {
          "enum": [
            "extraction",
            "research",
            "testing",
            "design",
            "specification",
            "fabrication",
            "distribution",
            "installation"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "value"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["values", "evidence"],
                "properties": {
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": ["string", "number"] }
                  },
                  "unit": { "type": "string", "minLength": 1 },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/citation" }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max", "evidence"],
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "step": { "type": "number", "exclusiveMinimum": 0 },
                  "unit": { "type": "string", "minLength": 1 },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/citation" }
                  }
                }
              }
            ]
          }
        },
        "expectedProfile": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "properties": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "parameters": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            },
            "interfaces": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "process"
              }
            }
          },
          "then": {
            "required": [
              "stage"
            ]
          },
          "else": {
            "not": {
              "required": [
                "stage"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source"
              }
            }
          },
          "then": {
            "required": [
              "source"
            ]
          },
          "else": {
            "not": {
              "required": [
                "source"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "parameters"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "productModel"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "expectedProfile"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "referenceDesign"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "mediaType"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "issuedOn": {
          "type": "string",
          "format": "date"
        },
        "retrievedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "retrievedOn": {
          "type": "string",
          "format": "date"
        },
        "validUntil": {
          "type": "string",
          "format": "date"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "sha256"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "retrievedAt"
                ]
              },
              {
                "required": [
                  "retrievedOn"
                ]
              }
            ]
          }
        }
      ]
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      },
      "minProperties": 1
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "locator"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit"
      ],
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "value": {
          "type": "number"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "min"
                ]
              },
              {
                "required": [
                  "max"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "min",
            "max"
          ],
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "basis",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "subject": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "predicate": {
          "enum": [
            "hasPart",
            "madeOf",
            "hasComposition",
            "hasStructure",
            "includesChemical",
            "realizesDesign",
            "isVariantOf",
            "usesConfiguration",
            "usesProduct",
            "manufacturedBy",
            "uses",
            "produces",
            "performedBy",
            "appliesTo",
            "supersedes",
            "compatibleWith",
            "incompatibleWith"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "property": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "value": {
          "type": [
            "string",
            "boolean"
          ]
        },
        "state": {
          "enum": [
            "unknown",
            "withheld"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "string",
          "minLength": 1
        },
        "geography": {
          "type": "string",
          "minLength": 1
        },
        "pcr": {
          "type": "string",
          "minLength": 1
        },
        "validUntil": {
          "type": "string",
          "format": "date"
        },
        "plantActor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "inheritedFrom": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "siQuantity": {
          "$ref": "#/$defs/quantity"
        },
        "basis": {
          "enum": [
            "measured",
            "simulated",
            "manufacturer-declared",
            "specification",
            "typical-reference",
            "inferred"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/citation"
          }
        },
        "derivedFrom": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "qualifiers": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "role": {
              "type": "string",
              "minLength": 1
            },
            "position": {
              "type": "string",
              "minLength": 1
            },
            "interface": {
              "type": "string",
              "minLength": 1
            },
            "sequence": {
              "type": "integer",
              "minimum": 1
            },
            "quantity": {
              "$ref": "#/$defs/quantity"
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "predicate",
            "target"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "property"
                ]
              },
              {
                "required": [
                  "value"
                ]
              },
              {
                "required": [
                  "quantity"
                ]
              },
              {
                "required": [
                  "state"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "property"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "predicate"
                ]
              },
              {
                "required": [
                  "target"
                ]
              }
            ]
          },
          "oneOf": [
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "quantity"
              ]
            },
            {
              "required": [
                "state"
              ]
            }
          ]
        }
      ]
    }
  }
}
