{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building materials educational guide v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "properties",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/propertyGuide"
      }
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/nodeGuide"
      }
    }
  },
  "$defs": {
    "propertyGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "betterDirection": { "type": "string", "minLength": 1 },
        "typicalRange": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "ucumUnit": { "type": "string", "minLength": 1 },
        "externalRefs": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "nodeGuide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "howItWorks": { "type": "string", "minLength": 1 },
        "whyItMatters": { "type": "string", "minLength": 1 },
        "tradeoffs": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "chemistry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "formula"
          ],
          "properties": {
            "formula": { "type": "string", "minLength": 1 },
            "atomicNumber": { "type": "integer", "minimum": 1 },
            "molarMass": { "type": "string", "minLength": 1 },
            "category": { "type": "string", "minLength": 1 },
            "role": { "type": "string", "minLength": 1 }
          }
        },
        "firm": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "segment"
          ],
          "properties": {
            "founded": { "type": "integer", "minimum": 1700 },
            "headquarters": { "type": "string", "minLength": 1 },
            "segment": { "type": "string", "minLength": 1 },
            "knownFor": { "type": "string", "minLength": 1 },
            "website": { "type": "string", "format": "uri", "pattern": "^https?://" }
          }
        }
      }
    }
  }
}
